#!/usr/bin/env bash
# Lint before each commit (fast; the tests run in CI). Turn on once per clone:
#   git config core.hooksPath .githooks
# Skipped where ShellCheck isn't installed, e.g. a Windows host without it.
command -v shellcheck >/dev/null 2>&1 || exit 0
exec "$(git rev-parse --show-toplevel)/tests/check.sh" lint
