#!/usr/bin/env python3
"""A stand-in for the `sbx` CLI, for the wrapper tests. Both wrappers' tests put this first on PATH
(Windows uses sbx.cmd, which runs this file). Its output and errors copy real sbx as captured in
docs/sbx-cli.md; change both together.

All state lives under $FAKE_SBX_DIR:
  calls                      every invocation, one JSON array of arguments per line
  sandboxes/<name>/status    running | stopped
  sandboxes/<name>/fs/...    the sandbox's filesystem, for `sbx cp`
  sandboxes/<name>/fail-cp   if present, every `sbx cp` touching this sandbox fails
  skill-<name>               how `sbx skills add --skill <name>` behaves:
                               ok (default) | exists | fail | hang | missing
                             exists: already installed, so sbx would ask before overwriting
                             fail also makes `sbx skills rm <name>` fail
                             missing: not installed, so `sbx skills rm <name>` fails with
                               the real "is not installed" message
  skill-<owner>__<repo>      the same, for `sbx skills add <owner>/<repo>` without --skill
  create-fails-with-mounts   if present, `sbx create` with extra mounts fails
  setup-fails                if present, running sandbox/setup.sh fails (and creates nothing)
  ls-plain                   if present, `sbx ls` prints statuses without the leading dot
  images                     the Images table rows for `sbx df --verbose`, one per line:
                               <repository> <tag> <image id> <containers>
  image-<id>                 if it says fail, `sbx template rm <id>` fails
  version                    what `sbx version` prints (default: v0.54.1 and a commit)
  signed-in                  if present, sbx diagnose reports you signed in; `sbx login` creates it
  login-fails                if present, `sbx login` fails and signs nobody in
  policy-set                 if present, the global network policy is initialized; `sbx policy init`
                               creates it
  policy-init-fails          if present, `sbx policy init` fails
  secret-github              the github secret's source, as `sbx secret set github --command` stored it
  secret-fails               if present, `sbx secret set` fails its verify step, as when the command
                               does
"""
import json
import os
import re
import shutil
import sys
import time

STATE = os.environ["FAKE_SBX_DIR"]
SANDBOXES = os.path.join(STATE, "sandboxes")
SANDBOX_PATH = re.compile(r"^([A-Za-z0-9_.-]{2,}):(/.*)$")   # name:/path, never a drive letter


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def resolve(arg):
    """Map an `sbx cp` argument to (sandbox name or None, local path)."""
    m = SANDBOX_PATH.match(arg)
    if not m:
        return None, arg
    name, path = m.groups()
    return name, os.path.join(SANDBOXES, name, "fs", path.lstrip("/"))


def cmd_cp(src, dst):
    (s_box, s), (d_box, d) = resolve(src), resolve(dst)
    for box in (s_box, d_box):
        if box and (not os.path.isdir(os.path.join(SANDBOXES, box))
                    or os.path.exists(os.path.join(SANDBOXES, box, "fail-cp"))):
            print(f"cp failed: {box}", file=sys.stderr)
            return 1
    if not os.path.exists(s):
        print(f"no such file: {src}", file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(os.path.abspath(d)), exist_ok=True)
    if os.path.isdir(s):
        shutil.copytree(s, d, dirs_exist_ok=True)
    else:
        shutil.copyfile(s, d)
    return 0


def cmd_ls(args):
    rows = []
    if os.path.isdir(SANDBOXES):
        for name in sorted(os.listdir(SANDBOXES)):
            rows.append({"name": name, "agent": "claude", "status": read(os.path.join(SANDBOXES, name, "status"))})
    if "--json" in args:
        # Shape of the real output (sbx ls --json), extra fields included.
        print(json.dumps([{
            "name": r["name"], "id": "25448636-451a-4e3d-989c-82148504cd16", "agent": r["agent"],
            "status": r["status"], "last_used_at": "2026-11-09T20:11:09.9219543Z",
            "mounts": ["D:\\My Projects\\x:/d/My Projects/x"], "workspaces": ["D:\\My Projects\\x"],
            "created_at": "2026-11-09T20:10:44Z"} for r in rows], indent=2))
    else:
        # Same layout as the real table, including the leading blank line and the status dot.
        # ls-plain: leave the dot off, as sbx may when its output isn't a terminal.
        print()
        print("  SANDBOX                     AGENT    STATUS      PORTS   WORKSPACE                     CREATED")
        for r in rows:
            plain = os.path.exists(os.path.join(STATE, "ls-plain"))
            dot = "●" if r["status"] == "running" else "○"
            status = r["status"] if plain else f"{dot} {r['status']}"
            print(f"  {r['name']:<27} {r['agent']:<8} {status:<11} {'':<7} D:\\My Projects\\x, C:\\h:/claude-history-sandbox:ro   42m")
    return 0


def cmd_skills(args):
    if args[:1] == ["update"]:
        return 0
    if args[:1] in (["rm"], ["remove"], ["delete"]):
        names = [a for a in args[1:] if not a.startswith("-")]
        for skill in names:
            mode = read(os.path.join(STATE, f"skill-{skill}"), "ok")
            if mode == "missing":   # the real message (docs/sbx-cli.md)
                print(f'error: skill "{skill}" is not installed\n  try: sbx skills ls', file=sys.stderr)
                return 1
            if mode == "fail":
                print(f"skill {skill}: not found", file=sys.stderr)
                return 1
        return 0
    if args[:1] == ["add"] and len(args) > 1:
        skill = args[args.index("--skill") + 1] if "--skill" in args else args[1].replace("/", "__")
        mode = read(os.path.join(STATE, f"skill-{skill}"), "ok")
        if mode == "hang":
            time.sleep(600)
        if mode == "exists":
            if "--no-input" in args:   # the real message (sbx skills add ... --no-input)
                print("\n  error: prompts are disabled by --no-input; run without --no-input to answer the prompt\n"
                      "    try: sbx skills add --help", file=sys.stderr)
            else:
                print("Overwrite? Error: stdin is not a terminal", file=sys.stderr)
            return 1
        if mode == "fail":
            print(f"skill {skill}: network error", file=sys.stderr)
            return 1
        return 0
    print(f"fake sbx: unsupported skills call {args}", file=sys.stderr)
    return 2


def cmd_df(args):
    # Layout of the real `sbx df --verbose`, captured in docs/sbx-cli.md.
    print("\n  Images space usage")
    print("  REPOSITORY                                TAG                IMAGE ID       CREATED   SIZE      SHARED SIZE   UNIQUE SIZE   CONTAINERS")
    for line in read(os.path.join(STATE, "images")).splitlines():
        repo, tag, image, containers = line.split()
        print(f"  {repo:<41} {tag:<18} {image:<14} 2w        unknown   25.05kB       unknown       {containers}")
    print("\n  Containers space usage")
    print("  CONTAINER ID   IMAGE                                    LOCAL VOLUMES   SIZE      CREATED   STATUS    NAMES")
    print("  26fd3c64ec27   sandbox-kit-assembled:8c076eb8c89a6a0d   1               1.332GB   16m       running   x")
    print("\n  Local volumes space usage")
    print("  VOLUME NAME                                  LINKS   SIZE")
    print("  x-docker                                     1       9.503MB")
    return 0


def cmd_template(args):
    if args[:1] in (["rm"], ["remove"], ["delete"]):
        image = [a for a in args[1:] if not a.startswith("-")][0]
        if read(os.path.join(STATE, f"image-{image}")) == "fail":
            print(f"image {image}: in use", file=sys.stderr)
            return 1
        print(f"\n  Removed template {image}\n")
        return 0
    print(f"fake sbx: unsupported template call {args}", file=sys.stderr)
    return 2


def out(text):
    """Print UTF-8 whatever the console's code page, as the real sbx does."""
    sys.stdout.flush()
    sys.stdout.buffer.write((text + "\n").encode("utf-8"))
    sys.stdout.flush()


def cmd_diagnose():
    # The CONNECTION section of the real output (docs/sbx-cli.md), shortened. The signed-out and
    # not-initialized wording isn't captured; the install treats anything else as not done.
    signed_in = os.path.exists(os.path.join(STATE, "signed-in"))
    policy = os.path.exists(os.path.join(STATE, "policy-set"))
    out("\n  INSTALLATION\n    ✓ CLI binary — found\n    ✓ Daemon — healthy\n")
    out("  CONNECTION\n    ✓ Version match — v0.54.1")
    out("    ✓ Authentication — authenticated" if signed_in
        else "    ✗ Authentication — not authenticated")
    out("    ✓ Global network policy — initialized" if policy
        else "    ✗ Global network policy — not initialized")
    out("\n    17 passed · 3 skipped\n")
    return 0


def cmd_login(args):
    if "--no-input" in args:   # the real message, whether or not you're signed in
        print("\n  error: interactive sign-in is disabled by --no-input\n"
              '    try: echo "$DOCKER_PAT" | sbx login --username <user> --password-stdin', file=sys.stderr)
        return 1
    if os.path.exists(os.path.join(STATE, "login-fails")):
        print("login failed", file=sys.stderr)
        return 1
    write(os.path.join(STATE, "signed-in"), "")
    return 0


def cmd_policy(args):
    if args[:1] == ["init"]:
        if os.path.exists(os.path.join(STATE, "policy-init-fails")):
            print("policy init failed", file=sys.stderr)
            return 1
        write(os.path.join(STATE, "policy-set"), args[1] if len(args) > 1 else "")
        return 0
    print(f"fake sbx: unsupported policy call {args}", file=sys.stderr)
    return 2


def cmd_secret(args):
    if args[:2] == ["set", "github"] and "--command" in args:
        if os.path.exists(os.path.join(STATE, "secret-fails")):   # the real message
            print("\n  error: verify command failed (exit_status): command: exit status 1 (use --show-error to "
                  "show the resolver error); use --no-verify to store without resolving now\n"
                  "    try: sbx secret set --help", file=sys.stderr)
            return 1
        write(os.path.join(STATE, "secret-github"), args[args.index("--command") + 1])
        return 0
    print(f"fake sbx: unsupported secret call {args}", file=sys.stderr)
    return 2


def main(argv):
    with open(os.path.join(STATE, "calls"), "a") as f:
        f.write(json.dumps(argv) + "\n")
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])

    if cmd == "create":
        name = args[args.index("--name") + 1]
        extra = args[args.index("--name") + 4:]   # after: --name <name> claude <workspace>
        if extra and os.path.exists(os.path.join(STATE, "create-fails-with-mounts")):
            print("invalid mount", file=sys.stderr)
            return 1
        write(os.path.join(SANDBOXES, name, "status"), "running")
        os.makedirs(os.path.join(SANDBOXES, name, "fs"), exist_ok=True)
        return 0
    if cmd == "cp":
        return cmd_cp(args[-2], args[-1])
    if cmd == "exec":
        rest = [a for a in args if a not in ("-i", "-it")]
        name = rest[0]
        # The real setup script always creates ~/.claude/projects; the fake does the same.
        # (sandbox/setup.sh itself is tested in tests/setup.bats.)
        if rest[1:3] == ["bash", "/tmp/claude-sandbox/setup.sh"]:
            if os.path.exists(os.path.join(STATE, "setup-fails")):
                print("claude-sandbox: couldn't restore session history", file=sys.stderr)
                return 1
            os.makedirs(os.path.join(SANDBOXES, name, "fs", "home/agent/.claude/projects"), exist_ok=True)
        return int(read(os.path.join(SANDBOXES, name, "exec-exit"), "0"))
    if cmd == "stop":
        write(os.path.join(SANDBOXES, args[0], "status"), "stopped")
        return 0
    if cmd == "rm":
        shutil.rmtree(os.path.join(SANDBOXES, args[-1]), ignore_errors=True)
        return 0
    if cmd == "ls":
        return cmd_ls(args)
    if cmd == "skills":
        return cmd_skills(args)
    if cmd == "df":
        return cmd_df(args)
    if cmd == "template":
        return cmd_template(args)
    if cmd == "version":
        print(read(os.path.join(STATE, "version"), "v0.54.1 3df896d5784200e8dfe6dca28ebd7102fe064169"))
        return 0
    if cmd == "diagnose":
        return cmd_diagnose()
    if cmd == "login":
        return cmd_login(args)
    if cmd == "policy":
        return cmd_policy(args)
    if cmd == "secret":
        return cmd_secret(args)
    print(f"fake sbx: unsupported command {argv}", file=sys.stderr)
    return 2


sys.exit(main(sys.argv[1:]))
