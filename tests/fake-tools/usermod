#!/usr/bin/env bash
# Fake for tests/install.bats: usermod -aG <group> <user>: adds the group to the account, not the session.
# State and the call log live in $FAKE_TOOLS_DIR (see tests/install.bats).
echo "$(basename "$0") $*" >> "$FAKE_TOOLS_DIR/calls"
echo "$2" >> "$FAKE_TOOLS_DIR/account-groups"
